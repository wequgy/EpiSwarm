# EpiSwarm Studio API Configuration
# Never commit actual secret keys to version control! Run 'python scripts/setup_keys.py' locally.

# 1. Google Gemini API (Recommended for advisor and narratives)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# 2. Free Local Logprob Decision Backend (Default & Recommended: Ollama, vLLM, or llama.cpp)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:1b

# 3. TypeSafe AI Jev (SystemOne) (Optional, paid service)
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

# 4. Generic OpenAI-Compatible Endpoint (Optional)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=gpt-4o-mini
